{
  "manifest_version": 3,
  "name": "Helixiri LinkedIn Bridge",
  "version": "1.0.1",
  "description": "LinkedIn messaging bridge for Helixiri Mission Control",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["*://www.linkedin.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.linkedin.com/messaging/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["*://www.linkedin.com/*"]
    }
  ]
}
