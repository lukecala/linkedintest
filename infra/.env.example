# Domain for HTTPS (Caddy auto-cert via Let's Encrypt)
DOMAIN=browser.example.com

# Basic auth for all endpoints
AUTH_USER=admin
AUTH_PASS=changeme

# Docker network name (shared between compose and dynamic containers)
DOCKER_NETWORK=browser-net

# Session manager port
SESSION_MANAGER_PORT=8080

# Max concurrent sessions (safety limit)
MAX_SESSIONS=4
